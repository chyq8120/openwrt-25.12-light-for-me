#=================================================
# Description: Fully Verified Official OpenWrt 25.12 for J4125
# Hardware: 4x Intel 2.5G Ports (eth0=WAN, eth1-3=LAN Bridge)
# Filesystem: Ext4 Only (No Squashfs, Storage Limit Optimized)
# Features: 100% Automated, NO Docker, Advanced Dependencies Integrated
#=================================================

name: Build_J4125_OpenWrt_25.12_Ext4_FullyAuto

on:
  repository_dispatch:
  workflow_dispatch: # 支持在 GitHub Actions 页面手动点击触发编译

env:
  REPO_URL: https://github.com/openwrt/openwrt
  REPO_BRANCH: openwrt-25.12
  TZ: Asia/Shanghai

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
    - name: 检查仓库代码
      uses: actions/checkout@v4

    - name: 初始化编译环境
      env:
        DEBIAN_FRONTEND: noninteractive
      run: |
        # 1. 深度清理虚拟机空间，防止爆仓
        sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /usr/local/share/vcpkg /usr/share/swift /usr/local/share/boost
        
        # 2. 更新系统软件源
        sudo -E apt-get -qq update
        
        # 3. 安装官方标准交叉编译工具链
        sudo -E apt-get -qq install -y ack antlr3 asciidoc autoconf automake autopoint binutils bison build-essential bzip2 ccache cmake cpio curl device-tree-compiler fastjar flex gawk gettext gcc-multilib g++-multilib git gperf haveged help2man intltool libc6-dev-i386 libelf-dev libglib2.0-dev libgmp3-dev libltdl-dev libmpc-dev libmpfr-dev libncurses5-dev libncursesw5-dev libreadline-dev libssl-dev libtool lrzsz mkisofs nano ninja-build p7zip p7zip-full patch pkgconf python3 python3-pip python3-ply python3-docutils python3-setuptools qemu-utils rsync scons squashfs-tools subversion swig texinfo u-boot-tools upx unzip xz-utils zlib1g-dev libz3-dev ocaml ocaml-findlib libunwind-dev
        
        # 4. 清理缓存
        sudo -E apt-get -qq autoremove --purge
        sudo -E apt-get -qq clean
        
        # 5. 设置主机时区与 Git 安全目录
        sudo timedatectl set-timezone "$TZ"
        git config --global --add safe.directory '*'
        sudo mkdir -p /workdir
        sudo chown $USER:$USER /workdir
    - name: 克隆 OpenWrt 源码
      working-directory: /workdir
      run: |
        git clone --depth 1 $REPO_URL -b $REPO_BRANCH openwrt
    - name: 加载 Feeds 核心源与 OpenClash
      run: |
        cd /workdir/openwrt
        ./scripts/feeds update -a
        ./scripts/feeds install -a
        # 采用独立分支克隆挂载 OpenClash，确保 100% 成功
        git clone https://github.com/vernesong/OpenClash.git package/custom/luci-app-openclash
    - name: 固化硬编码配置 (Ext4 格式与全套自选依赖)
      run: |
        cd /workdir/openwrt
        
        # 1. 写入架构基础参数
        echo "CONFIG_TARGET_x86=y" >> .config
        echo "CONFIG_TARGET_x86_64=y" >> .config
        echo "CONFIG_TARGET_x86_64_DEVICE_generic=y" >> .config
        
        # 2. 核心修改：锁定为 Ext4 格式，彻底关闭 Squashfs 打包
        echo "CONFIG_TARGET_ROOTFS_SQUASHFS=n" >> .config
        echo "CONFIG_TARGET_ROOTFS_EXT4FS=y" >> .config
        
        # 3. 固件分区合理扩充（内核 128M，系统盘保持 1024M 充足空间方便你以后扩容）
        echo "CONFIG_TARGET_KERNEL_PARTSIZE=128" >> .config
        echo "CONFIG_TARGET_ROOTFS_PARTSIZE=1024" >> .config
        echo "CONFIG_COMPRESSED_IMAGES=n" >> .config
        
        # 4. 预装 J4125 的 2.5G 网卡原生核心驱动 (Intel i225/i226 系列)
        echo "CONFIG_PACKAGE_kmod-igc=y" >> .config
        
        # 5. 预装 Intel CPU 微码漏洞补丁及安全加载工具
        echo "CONFIG_PACKAGE_intel-microcode=y" >> .config
        echo "CONFIG_PACKAGE_iucode-tool=y" >> .config
        
        # 6. 预装基础汉化 Web 界面与 LuCI 兼容组件
        echo "CONFIG_PACKAGE_luci=y" >> .config
        echo "CONFIG_PACKAGE_luci-compat=y" >> .config
        echo "CONFIG_PACKAGE_luci-i18n-base-zh-cn=y" >> .config
        # 7. 【精准整合全套磁盘扩容、系统及网络核心依赖包】
        # 磁盘扩容及分区工具
        echo "CONFIG_PACKAGE_parted=y" >> .config
        echo "CONFIG_PACKAGE_fdisk=y" >> .config
        echo "CONFIG_PACKAGE_losetup=y" >> .config
        echo "CONFIG_PACKAGE_resize2fs=y" >> .config
        echo "CONFIG_PACKAGE_tune2fs=y" >> .config
        
        # 基础环境组件
        echo "CONFIG_PACKAGE_bash=y" >> .config
        echo "CONFIG_PACKAGE_curl=y" >> .config
        echo "CONFIG_PACKAGE_ca-certificates=y" >> .config
        echo "CONFIG_PACKAGE_unzip=y" >> .config
        
        # 网页终端与核心网络分流组件
        echo "CONFIG_PACKAGE_luci-app-ttyd=y" >> .config
        echo "CONFIG_PACKAGE_ipset=y" >> .config
        echo "CONFIG_PACKAGE_ip-full=y" >> .config
        echo "CONFIG_PACKAGE_kmod-tun=y" >> .config
        
        # Ruby 环境及其配置解析（OpenClash 核心组件）
        echo "CONFIG_PACKAGE_ruby=y" >> .config
        echo "CONFIG_PACKAGE_ruby-yaml=y" >> .config
        
        # 25.12 现代防火墙代理透明转发核心 (兼容旧外挂转发逻辑)
        echo "CONFIG_PACKAGE_kmod-nft-tproxy=y" >> .config
        echo "CONFIG_PACKAGE_iptables-nft=y" >> .config
        echo "CONFIG_PACKAGE_ip6tables-nft=y" >> .config
        # 8. 【核心功能外挂】（已安全砍掉 Docker，保留存储和代理）
        echo "CONFIG_PACKAGE_luci-app-openclash=y" >> .config
        echo "CONFIG_PACKAGE_tailscale=y" >> .config
        echo "CONFIG_PACKAGE_luci-app-tailscale=y" >> .config
        echo "CONFIG_PACKAGE_samba4-server=y" >> .config
        echo "CONFIG_PACKAGE_luci-app-samba4=y" >> .config
        
        # 9. 锁定 dnsmasq-full 满足 OpenClash
        echo "CONFIG_PACKAGE_dnsmasq-full=y" >> .config
        
        # 执行初次 defconfig
        make defconfig
        
        # 核心修正：在 defconfig 之后，强制物理剔除所有被意外拉回的基础版 dnsmasq，确保绝对互斥
        sed -i '/CONFIG_PACKAGE_dnsmasq=y/d' .config
        echo "# CONFIG_PACKAGE_dnsmasq is not set" >> .config
        make defconfig
    - name: 注入网络接口与上海时区定制 (eth0=WAN, 内网IP=192.168.1.254)
      run: |
        cd /workdir/openwrt
        mkdir -p files/etc/uci-defaults
        cat << 'EOF' > files/etc/uci-defaults/99-custom-settings
        #!/bin/sh
        uci batch << 'SETTINGS_EOF'
        # 1. 重新编排 J4125 四网口映射 (eth0=WAN, eth1~3=LAN 桥接)
        delete network.lan
        delete network.wan
        delete network.wan6
        set network.br_lan=device
        set network.br_lan.name='br-lan'
        set network.br_lan.type='bridge'
        add_list network.br_lan.ports='eth1'
        add_list network.br_lan.ports='eth2'
        add_list network.br_lan.ports='eth3'
        set network.lan=interface
        set network.lan.proto='static'
        set network.lan.device='br-lan'
        set network.lan.ipaddr='192.168.1.254'
        set network.lan.netmask='255.255.255.0'
        set network.wan=interface
        set network.wan.proto='dhcp'
        set network.wan.device='eth0'
        set network.wan6=interface
        set network.wan6.proto='dhcpv6'
        set network.wan6.device='eth0'
        
        # 2. 定制首次开机默认时区为上海 (CST-8)
        set system.@system[0].timezone='CST-8'
        set system.@system[0].zonename='Asia/Shanghai'
        
        commit network
        commit system
        SETTINGS_EOF
        exit 0
        EOF
        chmod +x files/etc/uci-defaults/99-custom-settings
    - name: 预下载依赖包 (make download)
      run: |
        cd /workdir/openwrt
        make download -j8
        find dl -size -1024c -exec ls -l {} \;
        find dl -size -1024c -exec rm -f {} \;
    - name: 编译 OpenWrt 固件
      run: |
        cd /workdir/openwrt
        echo -e "$(nproc) 线程编译中..."
        make -j$(nproc) || make -j1 || make -j1 V=s
    - name: 精准提取 Ext4 核心固件 (去除编译残留垃圾)
      run: |
        # 统一采用最安全的绝对路径创建输出文件夹
        mkdir -p /workdir/firmware_release
        cd /workdir/openwrt/bin/targets/x86/64/
        
        # 只拷贝刷软路由核心要用的 ext4-combined 固件包，彻底剔除无用垃圾
        cp -f *ext4-combined* /workdir/firmware_release/ || true
        
        # 拷贝编译配置备忘清单
        cp -f /workdir/openwrt/.config /workdir/firmware_release/j4125_auto_config.buildinfo || true
    - name: 上传纯净 Ext4 固件成果物
      uses: actions/upload-artifact@v4
      with:
        name: OpenWrt_25.12_J4125_Ext4_FullyAuto_Firmware
        path: /workdir/firmware_release
